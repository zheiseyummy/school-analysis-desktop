{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "成绩分析系统",
  "version": "1.1.0",
  "identifier": "com.scoreanalysis.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev:tauri",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build:tauri",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "成绩分析系统",
        "width": 1440,
        "height": 900,
        "minWidth": 1080,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": [],
    "icon": ["../public/favicon.ico"]
  }
}
