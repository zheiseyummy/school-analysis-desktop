<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.youlai.system.mapper.SysStudentMapper">
    <select id="getAllStudentSexCount" resultType="com.youlai.system.model.bo.StudentSexCountBO">
        SELECT
            sex,
            count( id ) AS studentCount
        FROM
            sys_student
        GROUP BY
            sex;
    </select>
</mapper>